@@ -73,0 +74,28 @@ export type UserAiModelRecord = {
+type LiteLlmModelEnv = Cloudflare.Env & {
+  LITELLM_MODEL?: string;
+  LITELLM_MODEL_NAME?: string;
+  LITELLM_API_BASE?: string;
+  LITELLM_API_KEY?: string;
+};
+
+/**
+ * Composeから注入されたLiteLLM接続をuser共通modelへ変換する。
+ *
+ * @param env Workerへ渡された環境変数。
+ * @returns 必須値が揃った場合はLiteLLM model、未設定の場合はundefined。
+ */
+function getLiteLlmModel(env: Cloudflare.Env): UserAiModelRecord | undefined {
+  const {
+    LITELLM_MODEL: model,
+    LITELLM_MODEL_NAME: name,
+    LITELLM_API_BASE: apiUrl,
+    LITELLM_API_KEY: apiToken,
+  } = env as LiteLlmModelEnv;
+  if (!model || !apiUrl || !apiToken) return undefined;
+
+  return {
+    profile: {type: "agent", id: model, name: name || `LiteLLM · ${model}`},
+    config: {provider: "ollama", model, apiToken, apiUrl},
+  };
+}
