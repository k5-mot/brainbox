@@ -0,0 +1,90 @@
+import { afterEach, describe, expect, it, vi } from "vitest";
+import {
+  buildAuthorizeUrl,
+  exchangeCodeForVerifiedEmail,
+  generatePkce,
+  getOAuthConfig,
+  type KeycloakOAuthConfig,
+} from "../src/oauth.js";
+
+/**
+ * test間で差し替えたglobalを元へ戻す。
+ *
+ * @returns 戻し処理完了後にvoid。
+ */
+afterEach((): void => {
+  vi.restoreAllMocks();
+  vi.unstubAllGlobals();
+});
+
+describe("Keycloak OAuth", () => {
+  /**
+   * 公開issuerと内部issuerを用途別に設定できることを確認する。
+   *
+   * @returns test完了後にvoid。
+   */
+  it("公開URLを認可に使い内部URLをtoken交換に使う", (): void => {
+    const config = getOAuthConfig({
+      BASE_URL: "http://192.168.1.100:32500/gatekeeper/keycloak/",
+      CLIENT_ID: "cloudflare-os",
+      CLIENT_SECRET: "secret",
+      ISSUER_URL: "http://192.168.1.100:30001/realms/prod/",
+      INTERNAL_ISSUER_URL: "http://keycloak:8080/realms/prod/",
+    });
+    expect(config).toMatchObject({
+      issuerUrl: "http://192.168.1.100:30001/realms/prod",
+      internalIssuerUrl: "http://keycloak:8080/realms/prod",
+      redirectUri: "http://192.168.1.100:32500/gatekeeper/keycloak/oauth",
+    });
+  });
+
+  /**
+   * 認可URLがAuthorization Code、email scope、PKCEを必須にすることを確認する。
+   *
+   * @returns test完了後にvoid。
+   */
+  it("PKCE付きAuthorization Code URLを生成する", (): void => {
+    const config: KeycloakOAuthConfig = {
+      clientId: "cloudflare-os",
+      clientSecret: "secret",
+      issuerUrl: "https://sso.example.test/realms/prod",
+      internalIssuerUrl: "http://keycloak:8080/realms/prod",
+      redirectUri: "https://os.example.test/gatekeeper/keycloak/oauth",
+    };
+    const url = new URL(buildAuthorizeUrl(config, "state", "challenge"));
+    expect(url.origin).toBe("https://sso.example.test");
+    expect(url.searchParams.get("response_type")).toBe("code");
+    expect(url.searchParams.get("scope")).toBe("openid email profile");
+    expect(url.searchParams.get("code_challenge_method")).toBe("S256");
+  });
+
+  /**
+   * PKCE verifierとchallengeが十分なentropyと正しいdigestを持つことを確認する。
+   *
+   * @returns test完了時に解決するPromise。
+   */
+  it("S256 PKCE pairを生成する", async (): Promise<void> => {
+    const pair = await generatePkce();
+    expect(pair.verifier).toMatch(/^[\w-]{43}$/);
+    expect(pair.challenge).toMatch(/^[\w-]{43}$/);
+    expect(pair.challenge).not.toBe(pair.verifier);
+  });
+
+  /**
+   * token endpoint失敗時にidentityを受理しないことを確認する。
+   *
+   * @returns test完了時に解決するPromise。
+   */
+  it("token交換失敗を拒否する", async (): Promise<void> => {
+    vi.stubGlobal("fetch", vi.fn().mockResolvedValue(new Response("denied", {status: 401})));
+    const config: KeycloakOAuthConfig = {
+      clientId: "cloudflare-os",
+      clientSecret: "secret",
+      issuerUrl: "https://sso.example.test/realms/prod",
+      internalIssuerUrl: "https://sso-internal.example.test/realms/prod",
+      redirectUri: "https://os.example.test/gatekeeper/keycloak/oauth",
+    };
+    await expect(exchangeCodeForVerifiedEmail(config, "code", "verifier"))
+        .resolves.toBeNull();
+  });
+});
