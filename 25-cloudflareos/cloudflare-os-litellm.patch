+        /**
+         * 非secure originでも暗号学的乱数からUUID v4を生成する。
+         *
+         * @returns {string} UUID v4文字列。
+         */
+        crypto.randomUUID = function randomUUIDFallback() {
+          const bytes = crypto.getRandomValues(new Uint8Array(16));
